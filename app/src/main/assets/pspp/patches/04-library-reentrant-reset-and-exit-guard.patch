# Reason: Expose a library-callable entry point pspp_jni_run_main(argc, argv) with reentrant output/dataset state cleanup and siglongjmp guard instead of terminating the hosting Android JVM via exit().
--- a/src/ui/terminal/main.c
+++ b/src/ui/terminal/main.c
@@ -45,6 +45,25 @@
+#include <setjmp.h>
+#include <stdatomic.h>
+
+static TLS sigjmp_buf pspp_jni_exit_jmp;
+static TLS int pspp_jni_jmp_armed = 0;
+static atomic_int pspp_jni_cancel_requested = 0;
+
+void
+pspp_request_cancel (void)
+{
+  atomic_store (&pspp_jni_cancel_requested, 1);
+}
+
+int
+pspp_is_cancel_requested (void)
+{
+  return atomic_load (&pspp_jni_cancel_requested);
+}
+
+void
+pspp_safe_exit (int status)
+{
+  if (pspp_jni_jmp_armed)
+    siglongjmp (pspp_jni_exit_jmp, status == 0 ? 1000 : status);
+  exit (status);
+}
+
+#ifdef PSPP_ANDROID_LIBRARY
+#define main pspp_cli_entry_main
+#define exit(code) pspp_safe_exit(code)
+#endif
+
 int
